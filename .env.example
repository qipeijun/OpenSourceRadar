# 快速开始：只需在下面填写 OpenAI API key，其他默认值保持不变。
# 分析和公开检索默认共用此 key；保存到 .env 后重启服务生效。
# 密钥仅供本地服务端读取，不要提交到 Git 或粘贴到聊天。
AI_API_KEY=

# 本地服务，仅监听 127.0.0.1。默认网页地址：http://127.0.0.1:4310
PORT=4310
# 数据文件路径相对于启动目录；目录不存在时自动创建。
RADAR_DATABASE_PATH=./data/radar.sqlite
# 一批深入分析的项目数，范围 1–100；不是每日定时任务开关。
RADAR_BATCH_SIZE=10

# 可选：提高 GitHub API 可用额度。不要将真实密钥提交到仓库。
GITHUB_TOKEN=

# 选题分析：Chat Completions 接口，模型须支持 JSON 输出。
# 填 API 根地址，不要附加 /chat/completions。
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini

# 中文证据检索：首版使用 Responses API 的 web_search 工具。
# 默认模型与地址已填好；SEARCH_API_KEY 留空时复用上面的 AI_API_KEY。
# 仅当两个地址均为默认 OpenAI 地址时复用密钥；独立填写的检索 key 优先。
# 填 API 根地址，不要附加 /responses。
SEARCH_BASE_URL=https://api.openai.com/v1
SEARCH_API_KEY=
SEARCH_MODEL=gpt-4.1-mini

# DeepSeek 单 key 方案参见 .env.deepseek.example，分析与检索分别使用其支持的模型。
# 可选：接入其他兼容服务时，修改 AI_BASE_URL、AI_MODEL、AI_API_KEY。
# AI_MODEL 必须使用该服务实际支持的名称，不要沿用默认 OpenAI 模型名。
# 仅支持 Chat Completions 不代表支持公开检索；可继续保留 OpenAI 检索，
# 此时须另填 SEARCH_API_KEY 为 OpenAI key。自定义检索服务须支持 Responses + web_search。
# 模型权限与余额取决于你的 API 账号；配置完整不代表真实调用已验证。

# 可选 GPT 主服务（独立于 AI_* 备用服务与 SEARCH_* 检索服务）
# GPT_BASE_URL=http://你的网关/v1
# GPT_API_KEY=
# GPT_MODEL=gpt-6.1-sol
# GPT_WIRE_API=responses
# GPT_ACTOR_AUTHORIZATION=local-image-extension
# GPT_STORE_RESPONSES=false

# 生图能力单独配置：走上面的 GPT 网关地址与密钥，但必须显式给出网关目录中真实存在的图片模型。
# 程序不会用 GPT_MODEL 猜测生图模型；置空（GPT_IMAGE_MODEL=）即关闭配图。
# 2026-10-30 在该网关实测：gpt-image-2.5-sunburst 可生成与编辑图片，单张约 22–74 秒。
# GPT_IMAGE_MODEL=gpt-image-2.5-sunburst
